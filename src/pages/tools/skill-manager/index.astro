---
import { getCollection } from "astro:content";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";

const skills = (await getCollection("skills")).sort((a, b) =>
	a.data.title.localeCompare(b.data.title, "zh"),
);

const description = "发现并浏览我收集的 AI Skills";
---
<MainGridLayout title="Skill Manager" description={description}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative">
        <div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
            <!-- header -->
            <div class="flex items-center gap-2 mb-1 onload-animation">
                <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-[var(--primary)] flex items-center justify-center mr-1">
                    <Icon name="material-symbols:construction-rounded"></Icon>
                </div>
                <h1 class="font-bold text-2xl md:text-3xl text-black/90 dark:text-white/90">Skill Manager</h1>
            </div>
            <p class="text-sm text-black/50 dark:text-white/50 mb-5">
                发现并浏览我收集的 AI Skills（共 {skills.length} 个）。
            </p>

            <!-- search -->
            <div class="relative max-w-md mb-4">
                <input id="skill-search" type="search" placeholder="搜索技能名称 / 描述 / 标签…" autocomplete="off"
                       class="w-full h-11 pl-11 pr-4 rounded-xl text-sm font-medium bg-[var(--btn-regular-bg)] text-black/80 dark:text-white/80 placeholder:text-black/30 dark:placeholder:text-white/30 outline-none focus:ring-2 ring-[var(--primary)]/30 transition" />
                <Icon name="material-symbols:search-rounded" class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[1.25rem] text-black/30 dark:text-white/30 pointer-events-none"></Icon>
            </div>
            <div id="skill-count" class="text-xs text-black/40 dark:text-white/40 mb-3">共 {skills.length} 个技能</div>

            <!-- cards -->
            <div id="skill-list" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
                {skills.map((skill) => (
                    <a href={url(`/tools/skill-manager/skill/${skill.slug}/`)}
                       data-search={`${skill.data.title} ${skill.data.description} ${skill.data.tags.join(" ")}`.toLowerCase()}
                       class="group flex flex-col gap-2 p-5 rounded-[var(--radius-large)] bg-[var(--card-bg)] border border-black/5 dark:border-white/10 hover:border-[var(--primary)]/50 hover:-translate-y-0.5 transition"
                    >
                        <div class="flex items-start justify-between gap-2">
                            <h2 class="font-bold text-[var(--primary)] group-hover:underline break-all">{skill.data.title}</h2>
                            <div class="flex items-center gap-1 shrink-0">
                                <button type="button" class="copy-card p-1 -m-1 rounded-md hover:bg-[var(--btn-regular-bg)] transition text-black/35 dark:text-white/35 hover:text-[var(--primary)]"
                                        data-url={url(`/skills/${skill.slug}/SKILL.md`)} aria-label="复制 SKILL.md" title="复制 SKILL.md">
                                    <Icon name="material-symbols:content-copy-rounded" class="text-[1.125rem]"></Icon>
                                    <Icon name="material-symbols:check-rounded" class="copy-ok hidden text-[1.125rem] text-[var(--primary)]"></Icon>
                                </button>
                                <Icon name="material-symbols:arrow-forward-rounded" class="text-[1.25rem] text-black/20 dark:text-white/20 group-hover:text-[var(--primary)] transition"></Icon>
                            </div>
                        </div>
                        <p class="text-sm text-black/60 dark:text-white/60 line-clamp-2 flex-1 leading-relaxed">{skill.data.description}</p>
                        <div class="flex flex-wrap gap-1.5 items-center">
                            {skill.data.tags.map((tag) => (
                                <span class="skill-tag text-xs px-2 py-0.5 rounded-md bg-[var(--btn-regular-bg)] text-black/50 dark:text-white/50 hover:text-[var(--primary)] cursor-pointer transition" title="点击搜索该标签">{tag}</span>
                            ))}
                            <span class="text-xs font-medium text-[var(--primary)]/80 ml-auto">查看详情 →</span>
                        </div>
                    </a>
                ))}
            </div>
        </div>
    </div>
</MainGridLayout>

<script is:inline>
function initSkillSearch() {
	const input = document.getElementById("skill-search");
	const list = document.getElementById("skill-list");
	if (!input || !list || input.dataset.bound) return;
	input.dataset.bound = "1";

	const cards = Array.from(list.querySelectorAll("[data-search]"));
	const countEl = document.getElementById("skill-count");

	const update = () => {
		const kw = input.value.trim().toLowerCase();
		let shown = 0;
		for (const card of cards) {
			const match = !kw || (card.getAttribute("data-search") || "").includes(kw);
			card.classList.toggle("hidden", !match);
			if (match) shown++;
		}
		if (countEl) {
			countEl.textContent = kw
				? `共 ${cards.length} 个技能，匹配 ${shown} 个`
				: `共 ${cards.length} 个技能`;
		}
	};

	input.addEventListener("input", update);
	update();
}
document.addEventListener("DOMContentLoaded", initSkillSearch);
document.addEventListener("swup:content-replaced", initSkillSearch);
initSkillSearch();

function initCardCopy() {
	const list = document.getElementById("skill-list");
	if (!list || list.dataset.copyBound) return;
	list.dataset.copyBound = "1";

	list.addEventListener("click", async (e) => {
		const tag = e.target.closest(".skill-tag");
		if (tag) {
			e.preventDefault();
			e.stopPropagation();
			const input = document.getElementById("skill-search");
			if (input) {
				input.value = tag.textContent.trim();
				input.dispatchEvent(new Event("input"));
			}
			return;
		}

		const btn = e.target.closest(".copy-card");
		if (!btn) return;
		e.preventDefault();
		e.stopPropagation();

		try {
			const resp = await fetch(btn.getAttribute("data-url") || "");
			const text = await resp.text();
			await navigator.clipboard.writeText(text);
			const ok = btn.querySelector(".copy-ok");
			if (ok) ok.classList.remove("hidden");
			setTimeout(() => ok && ok.classList.add("hidden"), 2000);
		} catch (err) {
			// 复制失败：静默，用户仍可进入详情页复制
		}
	});
}
document.addEventListener("DOMContentLoaded", initCardCopy);
document.addEventListener("swup:content-replaced", initCardCopy);
initCardCopy();
</script>
