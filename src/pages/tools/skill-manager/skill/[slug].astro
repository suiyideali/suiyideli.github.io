---
import { getCollection, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
	const skills = await getCollection("skills");
	return skills.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const description = entry.data.description || entry.data.title;

// GitHub 仓库信息：技能原始文件随仓库发布在 public/skills/<slug>/SKILL.md
const GITHUB_RAW_BASE =
	"https://raw.githubusercontent.com/suiyideali/suiyideli.github.io/main";
const repoFileUrl = `${GITHUB_RAW_BASE}/public/skills/${entry.slug}/SKILL.md`;
const repoDirUrl = `https://github.com/suiyideali/suiyideli.github.io/tree/main/public/skills/${entry.slug}`;
const siteFileUrl = url(`/skills/${entry.slug}/SKILL.md`);
const installCmd = `mkdir -p ~/.dsh/skills/${entry.slug} && curl -fsSL ${repoFileUrl} -o ~/.dsh/skills/${entry.slug}/SKILL.md`;
---
<MainGridLayout title={entry.data.title} description={description}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
            <!-- 返回列表 -->
            <a href={url("/tools/skill-manager/")} class="inline-flex items-center gap-1 text-sm text-black/50 dark:text-white/50 hover:text-[var(--primary)] transition mb-6">
                <Icon name="material-symbols:arrow-back-rounded" class="text-[1.125rem]"></Icon>
                返回列表
            </a>

            <!-- 头部：标题 + 元信息 -->
            <h1 class="font-bold text-2xl md:text-3xl text-black/90 dark:text-white/90 mb-1">{entry.data.title}</h1>
            <div class="flex flex-wrap items-center gap-2 text-sm text-black/45 dark:text-white/45 mb-6">
                {entry.data.source && (
                    <span class="font-mono text-xs">来源：{entry.data.source}</span>
                )}
                {entry.data.tags.map((tag) => (
                    <span class="text-xs px-2 py-0.5 rounded-md bg-[var(--btn-regular-bg)] text-black/50 dark:text-white/50">{tag}</span>
                ))}
            </div>

            <!-- 描述 -->
            <section class="mb-8">
                <h2 class="flex items-center gap-2 font-bold text-lg text-black/80 dark:text-white/80 mb-3">
                    <span class="h-4 w-1 rounded-full bg-[var(--primary)]"></span>
                    描述
                </h2>
                <p class="text-[0.95rem] leading-relaxed text-black/65 dark:text-white/65">{entry.data.description}</p>
            </section>

            <!-- 获取这个 Skill -->
            <section class="mb-8">
                <h2 class="flex items-center gap-2 font-bold text-lg text-black/80 dark:text-white/80 mb-3">
                    <span class="h-4 w-1 rounded-full bg-[var(--primary)]"></span>
                    获取这个 Skill
                </h2>
                <p class="text-sm text-black/55 dark:text-white/55 mb-3 leading-relaxed">
                    选择你使用的 AI 工具，复制安装提示词粘贴给它即可自动安装；或直接复制 SKILL.md 手动放置到技能目录（如 <code class="font-mono text-xs px-1.5 py-0.5 rounded-md bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">~/.dsh/skills/{entry.slug}/</code>）。
                </p>
                <div class="flex flex-wrap items-center gap-2 mb-3">
                    <select id="env-select" aria-label="选择目标环境"
                            class="h-10 rounded-lg bg-[var(--btn-regular-bg)] px-3 text-sm font-medium text-black/75 dark:text-white/75 outline-none focus:ring-2 ring-[var(--primary)]/30 transition cursor-pointer">
                        <option value="claude-code">Claude Code</option>
                        <option value="codex">Codex</option>
                        <option value="dsh" selected>DSH</option>
                        <option value="workbuddy">WorkBuddy</option>
                    </select>
                    <button type="button" id="copy-install-prompt" data-slug={entry.slug} data-raw-url={repoFileUrl}
                            class="inline-flex items-center rounded-lg bg-[var(--btn-regular-bg)] px-4 py-2 text-sm font-medium text-black/75 dark:text-white/75 hover:text-[var(--primary)] transition">复制安装提示词</button>
                    <button type="button" id="copy-skill-file" data-site-url={siteFileUrl}
                            class="inline-flex items-center rounded-lg bg-[var(--btn-regular-bg)] px-4 py-2 text-sm font-medium text-black/75 dark:text-white/75 hover:text-[var(--primary)] transition">复制 SKILL.md</button>
                </div>
                <div class="flex flex-wrap items-center gap-2 text-xs text-black/45 dark:text-white/45">
                    <span>或从 GitHub 获取：</span>
                    <a href={repoFileUrl} target="_blank" class="hover:text-[var(--primary)] transition">raw 文件 ↗</a>
                    <span>·</span>
                    <a href={repoDirUrl} target="_blank" class="hover:text-[var(--primary)] transition">仓库目录 ↗</a>
                </div>
            </section>

            <!-- SKILL.md -->
            <section>
                <h2 class="flex items-center gap-2 font-bold text-lg text-black/80 dark:text-white/80 mb-3">
                    <span class="h-4 w-1 rounded-full bg-[var(--primary)]"></span>
                    SKILL.md
                </h2>

                <!-- 操作区：查看元信息按钮 + 预览/代码 分段滑块 -->
                <div class="flex flex-wrap items-center gap-3 mb-4">
                    <button type="button" id="skill-meta-btn" class="text-[13px] font-medium text-black/50 dark:text-white/50 hover:text-[var(--primary)] transition">查看元信息</button>
                    <div id="skill-tabs" role="tablist" class="inline-flex items-center rounded-lg bg-[var(--btn-regular-bg)] p-[2px] gap-[2px]">
                        <button type="button" role="tab" data-tab-target="preview" class="rounded-md px-3 py-1.5 text-[13px] font-medium transition-all duration-150 bg-[var(--card-bg)] shadow-sm text-black/85 dark:text-white/85">预览</button>
                        <button type="button" role="tab" data-tab-target="code" class="rounded-md px-3 py-1.5 text-[13px] font-medium transition-all duration-150 bg-transparent text-black/55 dark:text-white/55 hover:text-black/80 dark:hover:text-white/80">代码</button>
                    </div>
                </div>

                <!-- 预览：渲染后的 markdown -->
                <div data-tab-panel="preview">
                    <Markdown class="mt-2">
                        <Content />
                    </Markdown>
                </div>

                <!-- 代码：SKILL.md 源码 -->
                <div data-tab-panel="code" class="hidden">
                    <pre class="rounded-xl bg-[var(--btn-regular-bg)] text-black/85 dark:text-white/85 max-h-[32rem] overflow-auto p-4 text-sm font-mono leading-relaxed whitespace-pre"><code>{entry.body}</code></pre>
                </div>

                <!-- 元信息（点击「查看元信息」展开） -->
                <div id="skill-meta-panel" class="hidden">
                    <dl class="space-y-3 text-sm rounded-xl bg-[var(--btn-regular-bg)] p-5">
                        <div>
                            <dt class="text-xs font-bold uppercase tracking-wider text-black/40 dark:text-white/40 mb-0.5">标题</dt>
                            <dd class="text-black/80 dark:text-white/80">{entry.data.title}</dd>
                        </div>
                        <div>
                            <dt class="text-xs font-bold uppercase tracking-wider text-black/40 dark:text-white/40 mb-0.5">描述</dt>
                            <dd class="text-black/80 dark:text-white/80 leading-relaxed">{entry.data.description}</dd>
                        </div>
                        <div>
                            <dt class="text-xs font-bold uppercase tracking-wider text-black/40 dark:text-white/40 mb-0.5">标签</dt>
                            <dd class="text-black/80 dark:text-white/80">{entry.data.tags.join("、") || "—"}</dd>
                        </div>
                        <div>
                            <dt class="text-xs font-bold uppercase tracking-wider text-black/40 dark:text-white/40 mb-0.5">来源</dt>
                            <dd class="font-mono text-black/80 dark:text-white/80">{entry.data.source || "—"}</dd>
                        </div>
                    </dl>
                </div>
            </section>
        </div>
    </div>
</MainGridLayout>

<script is:inline>
function initSkillTabs() {
	const tabs = document.getElementById("skill-tabs");
	if (!tabs || tabs.dataset.bound) return;
	tabs.dataset.bound = "1";

	const btns = Array.from(tabs.querySelectorAll("[data-tab-target]"));
	const panels = Array.from(document.querySelectorAll("[data-tab-panel]"));
	const metaBtn = document.getElementById("skill-meta-btn");
	const metaPanel = document.getElementById("skill-meta-panel");

	const clearActive = () => {
		for (const b of btns) {
			b.classList.remove("bg-[var(--card-bg)]", "shadow-sm", "text-black/85", "dark:text-white/85");
			b.classList.add("bg-transparent", "text-black/55", "dark:text-white/55");
		}
	};

	const showPanel = (name) => {
		for (const p of panels) p.classList.toggle("hidden", p.dataset.tabPanel !== name);
		for (const b of btns) {
			const active = b.dataset.tabTarget === name;
			b.classList.toggle("bg-[var(--card-bg)]", active);
			b.classList.toggle("shadow-sm", active);
			b.classList.toggle("text-black/85", active);
			b.classList.toggle("dark:text-white/85", active);
			b.classList.toggle("bg-transparent", !active);
			b.classList.toggle("text-black/55", !active);
			b.classList.toggle("dark:text-white/55", !active);
		}
		if (metaPanel) metaPanel.classList.add("hidden");
	};

	for (const b of btns) {
		b.addEventListener("click", () => showPanel(b.dataset.tabTarget));
	}

	if (metaBtn && metaPanel) {
		metaBtn.addEventListener("click", () => {
			const willShow = metaPanel.classList.contains("hidden");
			for (const p of panels) p.classList.add("hidden");
			clearActive();
			metaPanel.classList.toggle("hidden", !willShow);
		});
	}

	showPanel("preview");
}
document.addEventListener("DOMContentLoaded", initSkillTabs);
document.addEventListener("swup:content-replaced", initSkillTabs);
initSkillTabs();

function initSkillGet() {
	const promptBtn = document.getElementById("copy-install-prompt");
	const fileBtn = document.getElementById("copy-skill-file");
	if (!promptBtn || promptBtn.dataset.bound) return;
	promptBtn.dataset.bound = "1";

	const feedback = (btn, ok) => {
		const orig = btn.textContent;
		btn.textContent = ok ? "已复制 ✓" : "复制失败";
		btn.classList.add("text-[var(--primary)]");
		setTimeout(() => {
			btn.textContent = orig;
			btn.classList.remove("text-[var(--primary)]");
		}, 2000);
	};

	const copyText = async (text, btn) => {
		try {
			await navigator.clipboard.writeText(text);
			feedback(btn, true);
		} catch (e) {
			const ta = document.createElement("textarea");
			ta.value = text;
			ta.style.position = "fixed";
			ta.style.opacity = "0";
			document.body.appendChild(ta);
			ta.select();
			try {
				document.execCommand("copy");
				feedback(btn, true);
			} catch (e2) {
				feedback(btn, false);
			}
			ta.remove();
		}
	};

	// ---- 各目标环境的 skills 目录（提示词第 1 步的安装位置） ----
	const ENV_DIRS = {
		"claude-code": ".claude/skills/",
		codex: ".codex/skills/",
		dsh: "~/.dsh/skills/",
		workbuddy: "~/.workbuddy/skills/",
	};

	const buildPrompt = () => {
		const select = document.getElementById("env-select");
		const env = select ? select.value : "dsh";
		const slug = promptBtn.getAttribute("data-slug") || "";
		const rawUrl = promptBtn.getAttribute("data-raw-url") || "";
		const dir = ENV_DIRS[env] || ENV_DIRS.dsh;
		const intro = dir.startsWith(".")
			? `请帮我将以下 skill 安装到当前项目的 ${dir} 目录下：`
			: `请帮我将以下 skill 安装到 ${dir} 目录下：`;

		return [
			intro,
			``,
			slug,
			``,
			`对应的 SKILL.md 文件链接如下：`,
			`- ${slug}: ${rawUrl}`,
			``,
			`请完成以下操作：`,
			`1. 在 ${dir} 目录下创建对应的 skill 文件夹`,
			`2. 下载上述链接中的 SKILL.md 文件内容`,
			`3. 保存到对应的 skill 目录中`,
			`4. 确认安装完成后告诉我已安装的 skill 列表`,
			`5. 确保 SKILL.md 里面的所有相对路径也基于当前文件链接被解析为 https 链接，并且递归地完成下载`,
		].join("\n");
	};

	promptBtn.addEventListener("click", async () => {
		try {
			await copyText(buildPrompt(), promptBtn);
		} catch (e) {
			feedback(promptBtn, false);
		}
	});

	if (fileBtn) {
		fileBtn.addEventListener("click", async () => {
			try {
				const resp = await fetch(fileBtn.getAttribute("data-site-url") || "");
				const text = await resp.text();
				await copyText(text, fileBtn);
			} catch (e) {
				feedback(fileBtn, false);
			}
		});
	}

	setMode("cli");
}
document.addEventListener("DOMContentLoaded", initSkillGet);
document.addEventListener("swup:content-replaced", initSkillGet);
initSkillGet();
</script>
