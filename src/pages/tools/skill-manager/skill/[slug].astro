---
import { getCollection, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
	const skills = await getCollection("skills");
	return skills.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const description = entry.data.description || entry.data.title;

// GitHub 仓库信息：技能原始文件随仓库发布在 public/skills/<slug>/SKILL.md
const GITHUB_RAW_BASE =
	"https://raw.githubusercontent.com/suiyideali/suiyideli.github.io/main";
const repoFileUrl = `${GITHUB_RAW_BASE}/public/skills/${entry.slug}/SKILL.md`;
const repoDirUrl = `https://github.com/suiyideali/suiyideli.github.io/tree/main/public/skills/${entry.slug}`;
const siteFileUrl = url(`/skills/${entry.slug}/SKILL.md`);
const installCmd = `mkdir -p ~/.dsh/skills/${entry.slug} && curl -fsSL ${repoFileUrl} -o ~/.dsh/skills/${entry.slug}/SKILL.md`;
---
<MainGridLayout title={entry.data.title} description={description}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
            <!-- 返回列表 -->
            <a href={url("/tools/skill-manager/")} class="inline-flex items-center gap-1 text-sm text-black/50 dark:text-white/50 hover:text-[var(--primary)] transition mb-6">
                <Icon name="material-symbols:arrow-back-rounded" class="text-[1.125rem]"></Icon>
                返回列表
            </a>

            <!-- 头部：标题 + 元信息 -->
            <h1 class="font-bold text-2xl md:text-3xl text-black/90 dark:text-white/90 mb-1">{entry.data.title}</h1>
            <div class="flex flex-wrap items-center gap-2 text-sm text-black/45 dark:text-white/45 mb-6">
                {entry.data.source && (
                    <span class="font-mono text-xs">来源：{entry.data.source}</span>
                )}
                {entry.data.tags.map((tag) => (
                    <span class="text-xs px-2 py-0.5 rounded-md bg-[var(--btn-regular-bg)] text-black/50 dark:text-white/50">{tag}</span>
                ))}
            </div>

            <!-- 描述 -->
            <section class="mb-8">
                <h2 class="flex items-center gap-2 font-bold text-lg text-black/80 dark:text-white/80 mb-3">
                    <span class="h-4 w-1 rounded-full bg-[var(--primary)]"></span>
                    描述
                </h2>
                <p class="text-[0.95rem] leading-relaxed text-black/65 dark:text-white/65">{entry.data.description}</p>
            </section>

            <!-- 获取这个 Skill -->
            <section class="mb-8">
                <h2 class="flex items-center gap-2 font-bold text-lg text-black/80 dark:text-white/80 mb-3">
                    <span class="h-4 w-1 rounded-full bg-[var(--primary)]"></span>
                    获取这个 Skill
                </h2>
                <p class="text-sm text-black/55 dark:text-white/55 mb-3 leading-relaxed">
                    选择你使用的 AI 工具，复制安装提示词粘贴给它即可自动安装；或直接复制 SKILL.md 手动放置到技能目录（如 <code class="font-mono text-xs px-1.5 py-0.5 rounded-md bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">~/.dsh/skills/{entry.slug}/</code>）。
                </p>
                <div class="flex flex-wrap items-center gap-2 mb-3">
                    <select id="env-select" aria-label="选择目标环境"
                            class="h-10 rounded-lg bg-[var(--btn-regular-bg)] px-3 text-sm font-medium text-black/75 dark:text-white/75 outline-none focus:ring-2 ring-[var(--primary)]/30 transition cursor-pointer">
                        <option value="claude-code">Claude Code</option>
                        <option value="codex">Codex</option>
                        <option value="dsh" selected>DSH</option>
                        <option value="workbuddy">WorkBuddy</option>
                    </select>
                    <button type="button" id="copy-install-prompt" data-slug={entry.slug} data-raw-url={repoFileUrl}
                            class="inline-flex items-center rounded-lg bg-[var(--btn-regular-bg)] px-4 py-2 text-sm font-medium text-black/75 dark:text-white/75 hover:text-[var(--primary)] transition">复制安装提示词</button>
                    <button type="button" id="copy-skill-file" data-site-url={siteFileUrl}
                            class="inline-flex items-center rounded-lg bg-[var(--btn-regular-bg)] px-4 py-2 text-sm font-medium text-black/75 dark:text-white/75 hover:text-[var(--primary)] transition">复制 SKILL.md</button>
                </div>
                <div class="flex flex-wrap items-center gap-2 text-xs text-black/45 dark:text-white/45">
                    <span>或从 GitHub 获取：</span>
                    <a href={repoFileUrl} target="_blank" class="hover:text-[var(--primary)] transition">raw 文件 ↗</a>
                    <span>·</span>
                    <a href={repoDirUrl} target="_blank" class="hover:text-[var(--primary)] transition">仓库目录 ↗</a>
                </div>
            </section>

            <!-- SKILL.md -->
            <section>
                <h2 class="flex items-center gap-2 font-bold text-lg text-black/80 dark:text-white/80 mb-3">
                    <span class="h-4 w-1 rounded-full bg-[var(--primary)]"></span>
                    SKILL.md
                </h2>

                <!-- 操作区：查看元信息按钮 + 预览/代码 分段滑块 -->
                <!-- 交互逻辑在 GlobalInteractions.astro：事件委托，SPA 导航后依然有效 -->
                <div class="flex flex-wrap items-center gap-3 mb-4">
                    <button type="button" id="skill-meta-btn" class="text-[13px] font-medium text-black/50 dark:text-white/50 hover:text-[var(--primary)] transition">查看元信息</button>
                    <div id="skill-tabs" role="tablist" class="inline-flex items-center rounded-lg bg-[var(--btn-regular-bg)] p-[2px] gap-[2px]">
                        <button type="button" role="tab" aria-selected="true" data-tab-target="preview" class="rounded-md px-3 py-1.5 text-[13px] font-medium transition-all duration-150 bg-[var(--card-bg)] shadow-sm text-black/85 dark:text-white/85">预览</button>
                        <button type="button" role="tab" aria-selected="false" data-tab-target="code" class="rounded-md px-3 py-1.5 text-[13px] font-medium transition-all duration-150 bg-transparent text-black/55 dark:text-white/55 hover:text-black/80 dark:hover:text-white/80">代码</button>
                    </div>
                </div>

                <!-- 预览：渲染后的 markdown -->
                <div data-tab-panel="preview">
                    <Markdown class="mt-2">
                        <Content />
                    </Markdown>
                </div>

                <!-- 代码：SKILL.md 源码 -->
                <div data-tab-panel="code" class="hidden">
                    <pre class="rounded-xl bg-[var(--btn-regular-bg)] text-black/85 dark:text-white/85 max-h-[32rem] overflow-auto p-4 text-sm font-mono leading-relaxed whitespace-pre"><code>{entry.body}</code></pre>
                </div>

                <!-- 元信息（点击「查看元信息」展开） -->
                <div id="skill-meta-panel" class="hidden">
                    <dl class="space-y-3 text-sm rounded-xl bg-[var(--btn-regular-bg)] p-5">
                        <div>
                            <dt class="text-xs font-bold uppercase tracking-wider text-black/40 dark:text-white/40 mb-0.5">标题</dt>
                            <dd class="text-black/80 dark:text-white/80">{entry.data.title}</dd>
                        </div>
                        <div>
                            <dt class="text-xs font-bold uppercase tracking-wider text-black/40 dark:text-white/40 mb-0.5">描述</dt>
                            <dd class="text-black/80 dark:text-white/80 leading-relaxed">{entry.data.description}</dd>
                        </div>
                        <div>
                            <dt class="text-xs font-bold uppercase tracking-wider text-black/40 dark:text-white/40 mb-0.5">标签</dt>
                            <dd class="text-black/80 dark:text-white/80">{entry.data.tags.join("、") || "—"}</dd>
                        </div>
                        <div>
                            <dt class="text-xs font-bold uppercase tracking-wider text-black/40 dark:text-white/40 mb-0.5">来源</dt>
                            <dd class="font-mono text-black/80 dark:text-white/80">{entry.data.source || "—"}</dd>
                        </div>
                    </dl>
                </div>
            </section>
        </div>
    </div>
</MainGridLayout>
